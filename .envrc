# Regenerate gemset.nix only when Gemfile.lock has actually moved ahead of it.
# Running bundix unconditionally here cost minutes on every `cd` into the repo,
# and a ^C leaves the nix child wedged in uninterruptible FUSE I/O, which then
# blocks every later git/direnv invocation in this tree.
watch_file Gemfile.lock
if [ Gemfile.lock -nt gemset.nix ]; then
  log_status "Gemfile.lock changed; regenerating gemset.nix via bundix"
  nix run nixpkgs#bundix -- -l
fi

use flake
