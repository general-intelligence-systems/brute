#!/usr/bin/env ruby
# frozen_string_literal: true

# Check CHANGELOG.md against the Keep a Changelog format.
#
#   bin/lint-changelog            # format only
#   bin/lint-changelog 4.1.0      # format, plus "is 4.1.0 ready to release?"
#
# Exits non-zero on any problem, which is what makes bin/release-gem a gate.

require_relative "../lib/brute"

USAGE = "Usage: bin/lint-changelog [version]"

if ARGV.size > 1 || ARGV.first&.start_with?("-")
  warn USAGE
  exit 1
end

version   = ARGV[0]
changelog = Brute::Changelog.load
problems  = version ? changelog.release_problems(version) : changelog.problems

if problems.empty?
  puts version ? "#{changelog.path} is clean and ready to release #{version}." : "#{changelog.path} is clean."
  exit 0
end

warn "#{problems.size} problem(s) in #{changelog.path}:"
warn ""
problems.each { |problem| warn "  #{problem}" }
exit 1
