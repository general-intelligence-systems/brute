#!/usr/bin/env ruby
# frozen_string_literal: true

# List the deprecations declared in the library.
#
#   bin/deprecations              # everything outstanding, by removal version
#   bin/deprecations 5.0.0        # only what comes due at 5.0.0; exit 1 if any
#
# The second form is the release gate: it is what bin/increment-version calls
# before bumping. A non-zero exit means the named version cannot ship until the
# listed names are actually removed.

require_relative "../lib/brute"

USAGE = "Usage: bin/deprecations [version]"

if ARGV.first&.start_with?("-")
  warn USAGE
  exit 1
end

due_at   = ARGV[0]
registry = Brute::Deprecate.registry

def render(entries)
  entries.sort_by { |entry| [entry.removed_in, entry.name] }.each do |entry|
    puts "  #{entry.removed_in.to_s.ljust(8)} #{entry}"
    puts "  #{" " * 8} #{entry.declared_at}" if entry.declared_at
  end
end

if registry.empty?
  puts "No deprecations declared."
  exit 0
end

if due_at
  pending = Brute::Deprecate.pending(due_at)

  if pending.empty?
    puts "No deprecations come due at #{due_at}. (#{registry.size} outstanding overall.)"
    exit 0
  end

  puts "#{pending.size} deprecation(s) come due at #{due_at} and must be removed first:"
  render(pending)
  exit 1
end

puts "#{registry.size} outstanding deprecation(s) (current version #{Brute::VERSION}):"
render(registry)
