#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/brute"

local_version = Brute::VERSION
gem_name = "brute"
gemspec = "brute.gemspec"

puts "Local version: #{local_version}"

# A release with no changelog entry is a release nobody can read. Gate on it
# before anything is built or pushed.
changelog_problems = Brute::Changelog.load.release_problems(local_version)
unless changelog_problems.empty?
  warn "ERROR: CHANGELOG.md is not ready to release #{local_version}:"
  warn ""
  changelog_problems.each { |problem| warn "  #{problem}" }
  warn ""
  abort "Run bin/update-changelog (then bin/lint-changelog #{local_version}) and try again."
end

# Same promise, other artefact: a version cannot ship past a removal deadline
# while the deprecated name is still in the tree.
due = Brute::Deprecate.pending(local_version)
unless due.empty?
  warn "ERROR: #{due.size} deprecation(s) come due in #{local_version} and are still present:"
  warn ""
  due.each { |entry| warn "  #{entry.removed_in.to_s.ljust(8)} #{entry}" }
  warn ""
  abort "Remove them (see bin/deprecations) and try again."
end

remote_output = `gem specification #{gem_name} version --remote 2>&1`

if $?.success?
  remote_version = remote_output[/version: (.+)/, 1]&.strip
  puts "Remote version: #{remote_version}"

  if Gem::Version.new(local_version) <= Gem::Version.new(remote_version)
    abort "ERROR: Local version (#{local_version}) has not been incremented past remote (#{remote_version})"
  end
else
  puts "Gem not yet published remotely, proceeding with first release"
end

puts "Building #{gemspec}..."
system("gem build #{gemspec}") || abort("ERROR: gem build failed")

gem_file = "#{gem_name}-#{local_version}.gem"
puts "Pushing #{gem_file}..."
system("gem push #{gem_file}") || abort("ERROR: gem push failed")

puts "Released #{gem_name} #{local_version}"
