---
/**
 * "Copy page as Markdown" control.
 *
 * The Markdown is fetched from the `<slug>.md` route emitted by
 * `src/pages/[...slug].md.ts`, so the source is not duplicated into the HTML.
 *
 * Class names prefixed `copy-md` are script hooks; everything visual is a
 * utility class.
 */
interface Props {
	/** URL of the raw Markdown for the current page. */
	markdownUrl: string;
}

const { markdownUrl } = Astro.props;

// `group` so the icon and the description brighten with the row, rather than
// the title being the only part that reacts.
// `bg-transparent`/`border-none` matter on the <button>: without them it keeps
// the browser's default grey button face, which the sibling <a> does not have.
const item =
	'group flex w-full cursor-pointer items-start gap-2.5 rounded-md border-none bg-transparent px-2.5 py-2 text-left no-underline hover:bg-gray-50/8';
const itemIcon =
	'icon-mask mt-0.5 size-4.5 text-(color:--sl-color-gray-4) group-hover:text-(color:--sl-color-gray-2)';
const itemTitle = 'text-sm leading-snug text-(color:--sl-color-white)';
const itemDesc =
	'text-xs leading-snug text-(color:--sl-color-gray-3) group-hover:text-(color:--sl-color-gray-2)';
---

<div
	class="copy-md relative mt-1 inline-flex shrink-0 items-stretch rounded-lg border border-(color:--sl-color-gray-5) bg-(--sl-color-bg) hover:border-(color:--sl-color-gray-4)"
	data-markdown-url={markdownUrl}
>
	<button
		class="copy-md-btn inline-flex cursor-pointer items-center gap-1.5 rounded-l-lg border-none bg-transparent px-2.5 py-1 text-xs font-semibold whitespace-nowrap text-(color:--sl-color-gray-2) hover:bg-(--sl-color-gray-6) hover:text-(color:--sl-color-white)"
		type="button"
		title="Copy page as Markdown"
	>
		<span class="icon-mask icon-copy size-3.5" aria-hidden="true"></span>
		<span class="copy-md-label" aria-live="polite">Copy page</span>
	</button>
	<button
		class="copy-md-toggle inline-flex cursor-pointer items-center rounded-r-lg border-none border-l border-l-(color:--sl-color-gray-5) bg-transparent px-1.5 text-(color:--sl-color-gray-2) hover:bg-(--sl-color-gray-6) hover:text-(color:--sl-color-white) aria-expanded:[&_.icon-chevron]:rotate-180"
		type="button"
		aria-label="More options"
		aria-expanded="false"
	>
		<span class="icon-mask icon-chevron size-3.5 transition-transform" aria-hidden="true"></span>
	</button>
	<div
		{/* The panel sits a step above the page so the row hover has something
		    to contrast against. */}
		class="copy-md-menu absolute end-0 top-[calc(100%+0.375rem)] z-10 min-w-60 rounded-lg border border-(color:--sl-color-gray-5) bg-(--sl-color-gray-6) p-1.5 shadow-lg"
		hidden
	>
		<button class={item} type="button" data-action="copy">
			<span class={`${itemIcon} icon-copy`} aria-hidden="true"></span>
			<span class="flex flex-col gap-0.5">
				<span class={itemTitle}>Copy page</span>
				<span class={itemDesc}>Copy page as Markdown for LLMs</span>
			</span>
		</button>
		<a class={item} href={markdownUrl} target="_blank" rel="noreferrer">
			<span class={`${itemIcon} icon-file`} aria-hidden="true"></span>
			<span class="flex flex-col gap-0.5">
				<span class={itemTitle}>View as Markdown</span>
				<span class={itemDesc}>View this page as plain text</span>
			</span>
		</a>
	</div>
</div>

<script>
	const LABEL = 'Copy page';

	function writeToClipboard(text: string) {
		if (window.isSecureContext && navigator.clipboard?.writeText) {
			return navigator.clipboard.writeText(text);
		}

		return new Promise<void>((resolve, reject) => {
			const textarea = document.createElement('textarea');

			textarea.value = text;
			textarea.setAttribute('readonly', '');
			textarea.style.position = 'fixed';
			textarea.style.top = '-9999px';
			document.body.appendChild(textarea);
			textarea.select();

			try {
				document.execCommand('copy') ? resolve() : reject(new Error('Copy failed'));
			} catch (error) {
				reject(error);
			} finally {
				document.body.removeChild(textarea);
			}
		});
	}

	function setup(root: HTMLElement) {
		if (root.dataset.wired) return;
		root.dataset.wired = 'true';

		const url = root.dataset.markdownUrl!;
		const button = root.querySelector<HTMLButtonElement>('.copy-md-btn')!;
		const toggle = root.querySelector<HTMLButtonElement>('.copy-md-toggle')!;
		const menu = root.querySelector<HTMLElement>('.copy-md-menu')!;
		const icon = button.querySelector<HTMLElement>('.icon-mask')!;
		const label = button.querySelector<HTMLElement>('.copy-md-label')!;

		let resetTimer: number | undefined;

		const setOpen = (open: boolean) => {
			menu.hidden = !open;
			toggle.setAttribute('aria-expanded', String(open));
		};

		const setCopied = (copied: boolean) => {
			icon.classList.toggle('icon-copy', !copied);
			icon.classList.toggle('icon-check', copied);
			label.textContent = copied ? 'Copied' : LABEL;
		};

		const copy = async () => {
			try {
				const response = await fetch(url);
				if (!response.ok) throw new Error(`HTTP ${response.status}`);
				await writeToClipboard(await response.text());

				setCopied(true);
				window.clearTimeout(resetTimer);
				resetTimer = window.setTimeout(() => setCopied(false), 2000);
			} catch {
				label.textContent = 'Copy failed';
				window.setTimeout(() => {
					label.textContent = LABEL;
				}, 2500);
			}
		};

		button.addEventListener('click', copy);

		toggle.addEventListener('click', (event) => {
			event.stopPropagation();
			setOpen(menu.hidden);
		});

		root.querySelector('[data-action="copy"]')!.addEventListener('click', () => {
			setOpen(false);
			copy();
		});

		document.addEventListener('click', (event) => {
			if (!menu.hidden && !root.contains(event.target as Node)) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !menu.hidden) {
				setOpen(false);
				toggle.focus();
			}
		});
	}

	const init = () => document.querySelectorAll<HTMLElement>('.copy-md').forEach(setup);

	init();
	document.addEventListener('astro:page-load', init);
</script>
