---
/**
 * Override of Starlight's `PageTitle`, adding a section eyebrow and the
 * "Copy page as Markdown" control beside the heading.
 *
 * Pages with a `hero` in their frontmatter render Starlight's `Hero` instead of
 * this component, so the splash home page is unaffected.
 */
import CopyPageMarkdown from './CopyPageMarkdown.astro';

const { id, entry, sidebar } = Astro.locals.starlightRoute;

// `BASE_URL` always ends in a slash; ids never start with one.
const markdownUrl = `${import.meta.env.BASE_URL}${id}.md`;

/**
 * The sidebar group holding the current page, used as an eyebrow above the
 * title. Derived from the sidebar so pages never have to restate their section
 * in frontmatter.
 */
function findGroup(entries: typeof sidebar, group?: string): string | undefined {
	for (const item of entries) {
		if (item.type === 'link' && item.isCurrent) return group;
		if (item.type === 'group') {
			const found = findGroup(item.entries, item.label);
			if (found) return found;
		}
	}
	return undefined;
}

const section = findGroup(sidebar);
---

<div>
	{
		section && (
			<p class="mb-1.5 text-base leading-tight font-semibold text-(color:--sl-color-text-accent)">
				{section}
			</p>
		)
	}
	<div class="flex flex-col items-end gap-0 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
		{/* `_top` is Starlight's PAGE_TITLE_ID, the target of its skip link. */}
		<h1
			id="_top"
			class="self-stretch text-(length:--sl-text-h1) leading-(--sl-line-height-headings) font-semibold text-(color:--sl-color-white) sm:self-auto"
		>
			{entry.data.title}
		</h1>
		<CopyPageMarkdown markdownUrl={markdownUrl} />
	</div>
</div>
